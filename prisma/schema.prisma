// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Phase 1 — Foundation
// Auth.js core tables (users, accounts, sessions, verification_tokens) plus
// the platform Settings singleton. See docs/database.md for the full entity
// list; later phases add events, event_sessions, registrations, etc.
// ---------------------------------------------------------------------------

enum UserRole {
  STUDENT
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("user_status")
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?  @map("email_verified")
  image         String?
  passwordHash  String?    @map("password_hash")
  role          UserRole   @default(STUDENT)
  status        UserStatus @default(PENDING)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  accounts             Account[]
  sessions             Session[]
  registrations        Registration[]
  seatHolds            SeatHold[]
  discountRedemptions  DiscountRedemption[]
  reviewedTransactions PaymentTransaction[]
  markedAttendance     SessionAttendance[]  @relation("AttendanceMarkedBy")
  notifications        Notification[]
  issuedCertificates   Certificate[]        @relation("CertificateIssuedBy")
  revokedCertificates  Certificate[]        @relation("CertificateRevokedBy")
  eventResources       EventResource[]
  reviews              Review[]
  auditLogs            AuditLog[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Singleton key-value operational configuration (seat-hold duration,
// join-window config, default time zone, currency, certificate defaults,
// maintenance mode). Read as a single row; see docs/database.md §2.16.
model Settings {
  id                        Int      @id @default(1)
  siteName                  String   @default("Ariba IT") @map("site_name")
  defaultTimeZone           String   @default("Asia/Dhaka") @map("default_time_zone")
  currency                  String   @default("BDT")
  seatHoldMinutes           Int      @default(15) @map("seat_hold_minutes")
  joinWindowBeforeMinutes   Int      @default(20) @map("join_window_before_minutes")
  joinWindowAfterMinutes    Int      @default(15) @map("join_window_after_minutes")
  bkashNagadReceivingMsisdn String   @default("01914638653") @map("bkash_nagad_receiving_msisdn")
  maintenanceMode           Boolean  @default(false) @map("maintenance_mode")

  // Contact and social — shown in the public footer/contact page.
  contactEmail  String? @map("contact_email")
  contactPhone  String? @map("contact_phone")
  facebookUrl   String? @map("facebook_url")
  linkedinUrl   String? @map("linkedin_url")

  // Transactional email sender identity & SMTP configuration
  emailFromName    String? @map("email_from_name")
  emailFromAddress String? @map("email_from_address")
  smtpHost         String? @map("smtp_host")
  smtpPort         Int?    @map("smtp_port")
  smtpUser         String? @map("smtp_user")
  smtpPassword     String? @map("smtp_password")

  // Rendered as-is (plain text/markdown, no HTML) on the public
  // /terms, /privacy and /refund-policy pages.
  termsContent   String? @db.Text @map("terms_content")
  privacyContent String? @db.Text @map("privacy_content")
  refundContent  String? @db.Text @map("refund_content")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Phase 2 — Event and Enrollment MVP
// Events, Sessions, Categories, Instructors and free registration/waitlist.
// Paid checkout (seat holds, payments) lands in Phase 3 — see tasklist.md.
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  events Event[]

  @@map("categories")
}

model Instructor {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  title     String?
  bio       String?  @db.Text
  avatarUrl   String?  @map("avatar_url")
  email       String?
  company     String?
  phone       String?
  website     String?
  twitterUrl  String?  @map("twitter_url")
  linkedinUrl String?  @map("linkedin_url")
  githubUrl   String?  @map("github_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  events        Event[]
  eventSessions EventSession[]

  @@map("instructors")
}

enum EventType {
  LIVE_CLASS
  TRAINING_PROGRAM
  WORKSHOP
  SEMINAR

  @@map("event_type")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  ONGOING
  COMPLETED
  CANCELLED
  ARCHIVED

  @@map("event_status")
}

model Event {
  id                   String      @id @default(cuid())
  title                String
  slug                 String      @unique
  shortDescription     String      @map("short_description")
  description          String      @db.Text
  type                 EventType
  categoryId           String      @map("category_id")
  instructorId         String      @map("instructor_id")
  thumbnailUrl         String?     @map("thumbnail_url")
  bannerUrl            String?     @map("banner_url")
  learningObjectives   String?     @map("learning_objectives") @db.Text
  targetAudience       String?     @map("target_audience") @db.Text
  prerequisites        String?     @db.Text
  language             String      @default("English")
  capacity             Int?
  priceBdt             Int         @default(0) @map("price_bdt")
  registrationOpensAt  DateTime?   @map("registration_opens_at")
  registrationClosesAt DateTime?   @map("registration_closes_at")
  startAt              DateTime    @map("start_at")
  endAt                DateTime    @map("end_at")
  featured             Boolean     @default(false)
  termsAndRefundPolicy String?     @map("terms_and_refund_policy") @db.Text
  status               EventStatus @default(DRAFT)
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  category       Category        @relation(fields: [categoryId], references: [id])
  instructor     Instructor      @relation(fields: [instructorId], references: [id])
  sessions       EventSession[]
  registrations  Registration[]
  seatHolds      SeatHold[]
  discountEvents DiscountEvent[]
  notifications  Notification[]
  resources      EventResource[]
  reviews        Review[]

  @@index([status])
  @@index([categoryId])
  @@index([instructorId])
  @@map("events")
}

enum SessionPlatform {
  ZOOM
  GOOGLE_MEET
  MICROSOFT_TEAMS
  CUSTOM

  @@map("session_platform")
}

enum SessionStatus {
  SCHEDULED
  JOIN_OPEN
  LIVE
  COMPLETED
  CANCELLED
  RESCHEDULED

  @@map("session_status")
}

// meetingUrl/meetingPasscode hold AES-256-GCM ciphertext (lib/security/crypto.ts),
// written by lib/events/session-actions.ts and decrypted only inside the
// protected join route (docs/security.md §4). Admin edit forms never
// display the decrypted value back — only overwrite-on-submit.
model EventSession {
  id               String          @id @default(cuid())
  eventId          String          @map("event_id")
  title            String
  sequence         Int
  description      String?         @db.Text
  startAt          DateTime        @map("start_at")
  endAt            DateTime        @map("end_at")
  timeZone         String          @default("Asia/Dhaka") @map("time_zone")
  hostInstructorId String?         @map("host_instructor_id")
  platform         SessionPlatform
  meetingId        String?         @map("meeting_id")
  meetingUrl       String?         @map("meeting_url")
  meetingPasscode  String?         @map("meeting_passcode")
  status           SessionStatus   @default(SCHEDULED)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  event          Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  hostInstructor Instructor?         @relation(fields: [hostInstructorId], references: [id])
  attendances    SessionAttendance[]
  notifications  Notification[]

  @@unique([eventId, sequence])
  @@index([eventId])
  @@map("event_sessions")
}

enum RegistrationStatus {
  PENDING_PAYMENT
  CONFIRMED
  WAITLISTED
  CANCELLED
  EXPIRED
  REFUNDED
  COMPLETED

  @@map("registration_status")
}

// Price/discount are snapshotted at registration time so later Event price
// changes never retroactively alter historical transactions (docs/database.md §5).
model Registration {
  id                        String             @id @default(cuid())
  userId                    String             @map("user_id")
  eventId                   String             @map("event_id")
  status                    RegistrationStatus @default(CONFIRMED)
  priceSnapshotBdt          Int                @map("price_snapshot_bdt")
  discountAmountSnapshotBdt Int                @default(0) @map("discount_amount_snapshot_bdt")
  couponCodeSnapshot        String?            @map("coupon_code_snapshot")
  confirmedAt               DateTime?          @map("confirmed_at")
  cancelledAt               DateTime?          @map("cancelled_at")
  cancellationReason        String?            @map("cancellation_reason")
  createdAt                 DateTime           @default(now()) @map("created_at")
  updatedAt                 DateTime           @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  seatHold           SeatHold?
  payment            Payment?
  discountRedemption DiscountRedemption?
  attendances        SessionAttendance[]
  certificate        Certificate?

  @@unique([userId, eventId])
  @@index([eventId, status])
  @@map("registrations")
}

// ---------------------------------------------------------------------------
// Phase 3 — Commerce (Manual bKash/Nagad)
// Seat holds for paid checkout, coupons, and the manual payment-proof review
// flow. Paid events do not support waitlisting in the MVP — if capacity is
// full, checkout is simply blocked; auto-promoting a waitlisted paid
// registration straight to CONFIRMED without payment would be a bug, and the
// alternative (a "seat offered, please pay" state) is deferred. See
// tasklist.md.
// ---------------------------------------------------------------------------

enum SeatHoldStatus {
  HELD
  CONFIRMED
  EXPIRED

  @@map("seat_hold_status")
}

// One hold per paid-checkout attempt (1:1 with the Registration it reserves
// a seat for). Only HELD holds count toward capacity; CONFIRMED/EXPIRED are
// kept for the seat-utilization/conversion reports in a later phase.
model SeatHold {
  id             String         @id @default(cuid())
  eventId        String         @map("event_id")
  userId         String         @map("user_id")
  registrationId String         @unique @map("registration_id")
  status         SeatHoldStatus @default(HELD)
  expiresAt      DateTime       @map("expires_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  event        Event        @relation(fields: [eventId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  registration Registration @relation(fields: [registrationId], references: [id])

  @@index([eventId, status])
  @@index([status, expiresAt])
  @@map("seat_holds")
}

enum DiscountType {
  PERCENTAGE
  FIXED

  @@map("discount_type")
}

model Discount {
  id              String       @id @default(cuid())
  code            String       @unique
  type            DiscountType
  amount          Int
  startsAt        DateTime?    @map("starts_at")
  expiresAt       DateTime?    @map("expires_at")
  maxTotalUsage   Int?         @map("max_total_usage")
  maxPerUserUsage Int?         @map("max_per_user_usage")
  minPurchaseBdt  Int          @default(0) @map("min_purchase_bdt")
  maxDiscountBdt  Int?         @map("max_discount_bdt")
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Empty = applies to every Event (sitewide coupon); non-empty scopes the
  // coupon to just the linked Events.
  events      DiscountEvent[]
  redemptions DiscountRedemption[]

  @@map("discounts")
}

// Empty events[] on the parent Discount means "applies sitewide" — this
// table only needs rows for coupons scoped to specific Events.
model DiscountEvent {
  id         String @id @default(cuid())
  discountId String @map("discount_id")
  eventId    String @map("event_id")

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([discountId, eventId])
  @@map("discount_events")
}

// One row per successful redemption, used to enforce total/per-user usage
// caps. Tied 1:1 to the Registration it discounted.
model DiscountRedemption {
  id                String   @id @default(cuid())
  discountId        String   @map("discount_id")
  userId            String   @map("user_id")
  registrationId    String   @unique @map("registration_id")
  discountAmountBdt Int      @map("discount_amount_bdt")
  createdAt         DateTime @default(now()) @map("created_at")

  discount     Discount     @relation(fields: [discountId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  registration Registration @relation(fields: [registrationId], references: [id])

  @@index([discountId, userId])
  @@map("discount_redemptions")
}

enum PaymentMethod {
  BKASH
  NAGAD

  @@map("payment_method")
}

enum PaymentStatus {
  INITIATED
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("payment_status")
}

// The logical payment record for one Registration. INITIATED until the
// student submits proof (-> PENDING); admin approve/reject moves it to
// PAID or FAILED. No gateway involved in the MVP — see docs/security.md §5.
model Payment {
  id             String        @id @default(cuid())
  registrationId String        @unique @map("registration_id")
  amountBdt      Int           @map("amount_bdt")
  status         PaymentStatus @default(INITIATED)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  registration Registration         @relation(fields: [registrationId], references: [id])
  transactions PaymentTransaction[]

  @@map("payments")
}

// One row per submitted proof (a student may resubmit after a rejection).
// trxId is unique per method globally — a real bKash/Nagad transaction ID
// can never confirm more than one registration (docs/database.md §4).
model PaymentTransaction {
  id              String        @id @default(cuid())
  paymentId       String        @map("payment_id")
  method          PaymentMethod
  receivingMsisdn String        @map("receiving_msisdn")
  senderMsisdn    String        @map("sender_msisdn")
  trxId           String        @map("trx_id")
  proofImageUrl   String?       @map("proof_image_url")
  status          PaymentStatus @default(PENDING)
  reviewedById    String?       @map("reviewed_by_id")
  reviewedAt      DateTime?     @map("reviewed_at")
  reviewNote      String?       @map("review_note")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  payment    Payment @relation(fields: [paymentId], references: [id])
  reviewedBy User?   @relation(fields: [reviewedById], references: [id])

  @@unique([method, trxId])
  @@index([paymentId])
  @@index([status])
  @@map("payment_transactions")
}

// ---------------------------------------------------------------------------
// Phase 4 — Live Delivery
// Protected Session join, manual attendance, and the in-app + email
// notification module (reminders, reschedule/cancel, announcements,
// completion). See tasklist.md.
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED

  @@map("attendance_status")
}

// A row can exist purely from a join click (joinedAt set, status still null
// — "evidence of attendance", not a verdict) or purely from an admin mark
// (status set, joinedAt still null — admin override). Both may be set.
model SessionAttendance {
  id             String            @id @default(cuid())
  registrationId String            @map("registration_id")
  eventSessionId String            @map("event_session_id")
  status         AttendanceStatus?
  joinedAt       DateTime?         @map("joined_at")
  markedById     String?           @map("marked_by_id")
  markedAt       DateTime?         @map("marked_at")
  note           String?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  registration Registration @relation(fields: [registrationId], references: [id])
  eventSession EventSession @relation(fields: [eventSessionId], references: [id])
  markedBy     User?        @relation("AttendanceMarkedBy", fields: [markedById], references: [id])

  @@unique([registrationId, eventSessionId])
  @@index([eventSessionId])
  @@map("session_attendance")
}

enum NotificationType {
  SESSION_REMINDER
  SESSION_RESCHEDULED
  SESSION_CANCELLED
  EVENT_CANCELLED
  EVENT_COMPLETED
  WAITLIST_PROMOTED
  ANNOUNCEMENT
  REGISTRATION_CONFIRMED
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  CERTIFICATE_ISSUED

  @@map("notification_type")
}

// Reminder de-duplication (idea.md §5.10: unique per user/session/type) is
// enforced at the application layer in the reminders cron, not a DB
// constraint here — a blanket unique on (userId, eventSessionId, type)
// would also wrongly collide two unrelated ANNOUNCEMENTs (eventSessionId
// null on both) for the same user.
model Notification {
  id             String           @id @default(cuid())
  userId         String           @map("user_id")
  type           NotificationType
  title          String
  body           String           @db.Text
  eventId        String?          @map("event_id")
  eventSessionId String?          @map("event_session_id")
  readAt         DateTime?        @map("read_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id])
  event        Event?        @relation(fields: [eventId], references: [id])
  eventSession EventSession? @relation(fields: [eventSessionId], references: [id])

  @@index([userId, readAt])
  @@index([eventSessionId, type])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Phase 5 — Certificates and Reporting
// Certificates (issue/revoke/reissue + public QR verification), Event
// resources, public reviews, and the audit log. Reports (docs/database.md
// §5.14) are read-only aggregate queries over existing tables — no new
// model needed for those. See tasklist.md.
// ---------------------------------------------------------------------------

enum CertificateStatus {
  ISSUED
  REVOKED

  @@map("certificate_status")
}

// verificationToken (not certificateNumber) is the public lookup key — the
// number is the human-readable label shown on the PDF, the token is what
// the QR code encodes, so a leaked/guessed number alone can't be used to
// probe the verification endpoint.
model Certificate {
  id                String            @id @default(cuid())
  registrationId    String            @unique @map("registration_id")
  certificateNumber String            @unique @map("certificate_number")
  verificationToken String            @unique @map("verification_token")
  status            CertificateStatus @default(ISSUED)
  issuedById        String            @map("issued_by_id")
  issuedAt          DateTime          @default(now()) @map("issued_at")
  revokedById       String?           @map("revoked_by_id")
  revokedAt         DateTime?         @map("revoked_at")
  revokeReason      String?           @map("revoke_reason")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  registration Registration @relation(fields: [registrationId], references: [id])
  issuedBy     User         @relation("CertificateIssuedBy", fields: [issuedById], references: [id])
  revokedBy    User?        @relation("CertificateRevokedBy", fields: [revokedById], references: [id])

  @@map("certificates")
}

// Admin-provided links (no file storage wired up — STORAGE_* env vars are
// still placeholders per docs/security.md §9). Access is still gated: the
// protected view route (mirrors the Session join route's pattern) checks
// for a CONFIRMED/COMPLETED registration before redirecting.
model EventResource {
  id          String   @id @default(cuid())
  eventId     String   @map("event_id")
  title       String
  url         String
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id])

  @@index([eventId])
  @@map("event_resources")
}

// Submitted by CONFIRMED/COMPLETED registrants; admin-moderated (published
// defaults false) before it can appear in public testimonials.
model Review {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  eventId   String   @map("event_id")
  rating    Int
  comment   String?  @db.Text
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
  @@map("reviews")
}

// Append-only from the application's perspective — no update/delete path
// is exposed anywhere. summary must never contain secrets (docs/security.md §8).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String   @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  summary    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([targetType, targetId])
  @@map("audit_logs")
}
